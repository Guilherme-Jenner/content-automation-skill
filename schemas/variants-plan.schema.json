{
  "type": "object",
  "required": ["bruto", "editor", "quantidade", "duracao_s", "variantes"],
  "properties": {
    "bruto": {"type": "string"},
    "editor": {"type": "string", "enum": ["local", "katana"]},
    "quantidade": {"type": "integer"},
    "duracao_s": {"type": "number", "exclusiveMinimum": 0},
    "variantes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "tipo", "trechos", "gancho", "ritmo", "legenda_estilo", "aprovada", "achados"],
        "properties": {
          "id": {"type": "string"},
          "tipo": {"type": "string", "enum": ["trecho_diferente", "mesmo_trecho_edicao_diferente"]},
          "trechos": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["inicio_s", "fim_s"],
              "properties": {
                "inicio_s": {"type": "number", "minimum": 0},
                "fim_s": {"type": "number", "exclusiveMinimum": 0}
              }
            }
          },
          "gancho": {"type": "string"},
          "gancho_repetido": {"type": "boolean"},
          "justificativa_gancho": {"type": "string"},
          "ritmo": {
            "type": "object",
            "required": ["min_silencio_s", "margem_s"],
            "properties": {
              "min_silencio_s": {"type": "number", "exclusiveMinimum": 0},
              "margem_s": {"type": "number", "minimum": 0}
            }
          },
          "legenda_estilo": {"type": "string", "enum": ["padrao", "destaque", "discreto"]},
          "aprovada": {"type": "boolean"},
          "achados": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
