{
  "type": "object",
  "required": ["posts"],
  "properties": {
    "posts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "video", "legenda", "hashtags", "perfis", "data_hora"],
        "properties": {
          "id": {"type": "string"},
          "video": {"type": "string"},
          "legenda": {"type": "string"},
          "hashtags": {"type": "array", "items": {"type": "string"}},
          "perfis": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "required": ["rede", "conta"],
              "properties": {
                "rede": {"type": "string", "enum": ["instagram", "tiktok"]},
                "conta": {"type": "string"}
              }
            }
          },
          "data_hora": {"type": "string"}
        }
      }
    }
  }
}
